{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/airesearchagl-art/explainer-reel-kit/blob/main/src/explainer_reel_kit/data/schema/storyboard.schema.json",
  "title": "explainer-reel-kit Storyboard",
  "description": "台本（ストーリーボード）スキーマ kit-1.1.0。全工程（説明図・撮影・ナレーション・スライド・書き出し）が共有する唯一の約束事。intro / outro は固定テンプレートのスロット、scenes は 1 シーン＝1 スライド＝主画像 1 枚。1.0.0 / 1.1.0 の台本（web / manual / generated の画像だけを使うもの）もそのまま読める（docs/design/storyboard.md）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reel",
    "intro",
    "outro",
    "scenes"
  ],
  "properties": {
    "reel": {
      "$ref": "#/$defs/reel"
    },
    "intro": {
      "$ref": "#/$defs/intro"
    },
    "outro": {
      "$ref": "#/$defs/outro"
    },
    "scenes": {
      "type": "array",
      "description": "本編シーン。1シーン＝1スライド。5〜8 を推奨（範囲外は検証スクリプトが警告）。",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 64
    },
    "reel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "schema_version",
        "audience",
        "kind",
        "output_name"
      ],
      "if": {
        "required": [
          "confidentiality"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.1.0",
              "kit-1.0.0",
              "kit-1.1.0"
            ]
          }
        }
      },
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "リール識別子（英小文字・数字・-・_）"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "動画タイトル。intro スライドの大見出しにも使う"
        },
        "schema_version": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "kit-1.0.0",
            "kit-1.1.0"
          ],
          "description": "新しく書く台本は kit-1.1.0。1.0.0 / 1.1.0 / kit-1.0.0 の台本もそのまま読める（1.0.0 には confidentiality を書けない。kind: explainer は kit-1.1.0 から）"
        },
        "audience": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "description": "見る人。A: 初めての人 / B: よく使う人・詳しい人 / C: 専門家・作る人（docs/design/storyboard.md）"
        },
        "kind": {
          "enum": [
            "tool_intro",
            "work_manual",
            "explainer"
          ],
          "description": "tool_intro: ツールの紹介 / work_manual: 作業の手順 / explainer: 一般の解説（問い → しくみ → 比べる → 選び方 → まとめ。kit-1.1.0 から）"
        },
        "confidentiality": {
          "enum": [
            "confidential",
            "general"
          ],
          "description": "社外秘の区分。confidential: 社外秘（所属先の外に出せない情報）を含む・分からない／general: 公開済みの情報・一般的な知識だけ。書いていなければ confidential として扱う（安全側）"
        },
        "aspect": {
          "enum": [
            "16:9"
          ],
          "default": "16:9",
          "description": "いまは 16:9 のみ"
        },
        "voice": {
          "$ref": "#/$defs/voice"
        },
        "output_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "maxLength": 80,
          "description": "出力ファイル名の基部（拡張子なし）。.pptx / .mp4 / WAV 群の名前に使う"
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "description": "TTS 設定（任意）。省略時は Narration 工程の既定値",
      "properties": {
        "engine": {
          "enum": [
            "aivisspeech"
          ],
          "default": "aivisspeech"
        },
        "speaker": {
          "description": "音声合成の声（AivisSpeech ではスタイル ID の整数）",
          "type": [
            "integer",
            "string"
          ]
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.0,
          "default": 1.0,
          "description": "話速（speedScale）"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2.0,
          "default": 1.0,
          "description": "音量（volumeScale）"
        }
      }
    },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "description": "冒頭スライド（固定テンプレート）。何ができるか・誰向けか・前提・所要時間",
      "required": [
        "summary",
        "narration"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "この動画でできること／分かること（画面に出す）"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "前提ツール・権限・環境（対象 C では必須推奨）"
        },
        "duration_note": {
          "type": "string",
          "default": "未計測",
          "description": "作業の所要時間。根拠がなければ『未計測』"
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "duration_sec": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "outro": {
      "type": "object",
      "additionalProperties": false,
      "description": "まとめスライド（固定テンプレート）。成果・確認すること・次の行動",
      "required": [
        "summary",
        "narration"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "再現チェック・未確認事項・注意点"
        },
        "next": {
          "type": "string",
          "description": "次の行動・関連リンク（画面に出す短文）"
        },
        "image": {
          "$ref": "#/$defs/image",
          "description": "最終成果品の画像（任意）"
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "duration_sec": {
          "$ref": "#/$defs/duration"
        }
      }
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120,
      "description": "表示秒数の目安。Narration 工程で WAV 長＋余白が確定したらそちらで上書きする"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "ref",
        "label"
      ],
      "properties": {
        "source": {
          "enum": [
            "web",
            "manual",
            "generated"
          ],
          "description": "web: Web 画面の撮影 / manual: 人が用意する画像 / generated: 説明図など作った画像"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\:*?\"<>|]+\\.(png|jpg|jpeg|webp|gif|svg)$",
          "description": "画像パス（台本ファイルからの相対、/ 区切り）。manual は実在必須。web / generated は撮影・説明図の段が書き出す予定パス"
        },
        "label": {
          "enum": [
            "実キャプチャ",
            "途中成果",
            "説明用再構成図"
          ],
          "description": "画像の来歴（実キャプチャ／途中成果／説明用再構成図）。画面を捏造しない"
        },
        "alt": {
          "type": "string",
          "description": "画像の説明（代替テキスト）"
        }
      }
    },
    "recipe": {
      "enum": [
        "fade_sequence",
        "highlight_box",
        "arrow_move",
        "morph_transition",
        "text_build"
      ],
      "description": "アニメーションレシピ名。追加・削除はマイナーバージョンを上げる"
    },
    "capture_web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "steps"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "撮影前に行う操作（人が読める手順。実際の操作は操作定義に書く）"
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 320
            },
            "height": {
              "type": "integer",
              "minimum": 240
            }
          }
        }
      }
    },
    "capture_manual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions"
      ],
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1,
          "description": "人が撮影・用意するときの指示"
        }
      }
    },
    "capture_generated": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "prompt"
          ]
        },
        {
          "required": [
            "src"
          ]
        }
      ],
      "if": {
        "properties": {
          "tool": {
            "const": "html"
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "required": [
          "src"
        ]
      },
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "何を描く図か（人と AI が読む説明）"
        },
        "tool": {
          "type": "string",
          "description": "描き方。html: src の HTML を描いて PNG と注釈位置を出す（kit-1.0.0）"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\:*?\"<>|]+\\.html?$",
          "description": "説明図の HTML（台本ファイルからの相対、/ 区切り。kit-1.0.0）"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "heading",
        "image",
        "narration",
        "recipe"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "シーン ID（台本内で一意）"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "動詞で終わる行動の見出し（例: 条件を入力する）"
        },
        "where": {
          "type": "string",
          "description": "実行場所・使用ツール（任意）"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "on_screen_text": {
          "type": "string",
          "maxLength": 60,
          "description": "画面に出す短文（任意）"
        },
        "narration": {
          "type": "string",
          "minLength": 1,
          "description": "ナレーション原稿。.pptx のノート欄に入る"
        },
        "duration_sec": {
          "$ref": "#/$defs/duration"
        },
        "recipe": {
          "$ref": "#/$defs/recipe"
        },
        "recipe_params": {
          "type": "object",
          "description": "レシピ固有の補助パラメータ（注釈の mark 名など）。形式は docs/design/recipes.md（スキーマでは拘束しない）"
        },
        "check": {
          "type": "string",
          "description": "確認事項（任意）"
        },
        "capture": {
          "type": "object",
          "description": "工程別の撮影指示（任意）。image.source に対応する形式で書く"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "image": {
                "properties": {
                  "source": {
                    "const": "web"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "capture": {
                "$ref": "#/$defs/capture_web"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "image": {
                "properties": {
                  "source": {
                    "const": "manual"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "capture": {
                "$ref": "#/$defs/capture_manual"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "image": {
                "properties": {
                  "source": {
                    "const": "generated"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "capture": {
                "$ref": "#/$defs/capture_generated"
              }
            }
          }
        }
      ]
    }
  }
}
